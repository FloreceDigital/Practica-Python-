# Copia este archivo como .env y rellena los valores. NUNCA subas el .env a GitHub.

# --- Claude (https://platform.claude.com) ---
ANTHROPIC_API_KEY=sk-ant-...
# CHATBOT_MODEL=claude-opus-5-5
# CHATBOT_EFFORT=low

# --- Meta ---
# Un texto secreto que tú inventas; ponlo igual en el panel de Meta al configurar el webhook.
META_VERIFY_TOKEN=invente-una-clave-larga
# Panel de la app de Meta > Configuración > Básica > Clave secreta de la app
META_APP_SECRET=
# GRAPH_API_VERSION=v23.0

# WhatsApp: panel de la app > WhatsApp > Configuración de la API
WHATSAPP_TOKEN=
# Messenger: panel de la app > Messenger > Configuración de la API > Token de la página
MESSENGER_PAGE_TOKEN=

# --- Tu negocio ---
NOMBRE_NEGOCIO=Florece Digital
# MAX_MENSAJES_HISTORIAL=20
